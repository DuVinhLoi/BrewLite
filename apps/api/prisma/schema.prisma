generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  BARISTA
}
enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  WALLET
  CARD
}
enum PaymentStatus {
  SUCCESS
  FAILED
}
model Product {
  id String @id @default(cuid())
  name String
  description String
  price Int
  imageUrl String
  stock Int @default(0)
  items OrderItem[]
  recipes Recipe[]
  @@map("products")
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role @default(CUSTOMER)
  orders Order[]
  payments Payment[]
  stockMovements StockMovement[]
  @@map("users")
}
model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  total Int
  createdAt DateTime @default(now())
  items OrderItem[]
  payments Payment[]
  inventoryTracked Boolean @default(false)
  ingredients OrderIngredient[]
  @@index([userId, createdAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  productId String
  product Product @relation(fields: [productId], references: [id])
  name String
  size String
  toppings String[]
  quantity Int
  unitPrice Int
  lineTotal Int
  @@map("order_items")
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  method PaymentMethod
  status PaymentStatus
  amount Int
  idempotencyKey String
  fingerprint String
  createdAt DateTime @default(now())
  @@index([userId, idempotencyKey])
  @@map("payments")
}

model Ingredient {
  id String @id @default(cuid())
  name String @unique
  unit String
  tracked Boolean @default(true)
  onHand Decimal @default(0) @db.Decimal(18, 3)
  reserved Decimal @default(0) @db.Decimal(18, 3)
  recipeLines RecipeLine[]
  movements StockMovement[]
  orders OrderIngredient[]
  @@map("ingredients")
}

model Recipe {
  id String @id @default(cuid())
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  size String?
  topping String? @unique
  lines RecipeLine[]
  @@unique([productId, size])
  @@map("recipes")
}

model RecipeLine {
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(18, 3)
  @@id([recipeId, ingredientId])
  @@map("recipe_lines")
}

model StockMovement {
  id String @id @default(cuid())
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  kind String
  quantity Decimal @db.Decimal(18, 3)
  onHandAfter Decimal @db.Decimal(18, 3)
  reason String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("stock_movements")
}

model OrderIngredient {
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(18, 3)
  @@id([orderId, ingredientId])
  @@map("order_ingredients")
}
