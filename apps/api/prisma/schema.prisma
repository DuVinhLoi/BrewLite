generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String
  stock       Int    @default(0)

  @@map("products")
}
