DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/brewlite?schema=public
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Generate random secret >=32 characters. Never put this in apps/web.
JWT_SECRET=
# Opt-in only for independent demo/test databases; never enable in production.
SEED_DEMO_USERS=false

# VNPay sandbox (optional). Without these the API still starts, but creating a payment URL returns 502.
VNP_TMN_CODE=
VNP_HASH_SECRET=
WEB_URL=http://localhost:3000
# Optional, sandbox defaults are built in.
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
