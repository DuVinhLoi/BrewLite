@startuml
skinparam DefaultFontColor #1f2937
skinparam ArrowColor #5b6b8c
skinparam ArrowFontColor #1f2937
skinparam PackageBackgroundColor #f8fafc
skinparam PackageBorderColor #94a3b8
skinparam ClassBackgroundColor #eef2fb
skinparam ClassBorderColor #5b6b8c
skinparam ClassFontColor #1f2937
skinparam StateBackgroundColor #eef2fb
skinparam StateBorderColor #5b6b8c
skinparam StateFontColor #1f2937
skinparam ComponentBackgroundColor #eef2fb
skinparam ComponentBorderColor #5b6b8c
skinparam SequenceParticipantBackgroundColor #eef2fb
skinparam SequenceParticipantBorderColor #5b6b8c
skinparam SequenceLifeLineBorderColor #5b6b8c
skinparam NoteBackgroundColor #fef3c7
skinparam NoteBorderColor #d97706
skinparam NoteFontColor #1f2937
' BrewLite A2 SRS section 3.6 is the authoritative source.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
title BrewLite A2 — Class: Domain model (SRS 3.6)

class User {
  +id: String
  +email: String
  +passwordHash: String
  +role: Role
}
class Product {
  +id: String
  +name: String
  +description: String
  +price: Integer
  +imageUrl: String
  +stock: Integer <<legacy>>
}
class Order {
  +id: String
  +userId: String
  +status: OrderStatus
  +inventoryTracked: Boolean
  +total: Integer
  +discountAmount: Integer
  +promotionId: String [0..1]
  +createdAt: DateTime
}
class OrderItem {
  +id: String
  +orderId: String
  +productId: String
  +size: String
  +toppings: String[*]
  +quantity: Integer
  +unitPrice: Integer
  +lineTotal: Integer
}
class Payment {
  +id: String
  +orderId: String
  +method: PaymentMethod
  +status: PaymentStatus
  +amount: Integer
  +idempotencyKey: String
  +createdAt: DateTime
}
class Promotion {
  +id: String
  +code: String
  +discountPercent: Decimal
  +validFrom: DateTime
  +validTo: DateTime
  +maxUses: Integer [0..1]
  +usedCount: Integer
  +active: Boolean
}
class LoyaltyTransaction {
  +id: String
  +userId: String
  +orderId: String [0..1]
  +type: LoyaltyType
  +points: Integer
  +createdAt: DateTime
}

enum Role {
  CUSTOMER
  BARISTA
}
enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  WALLET
  CARD
}
enum PaymentStatus {
  SUCCESS
  FAILED
  REFUNDED
}
enum LoyaltyType {
  EARN
  REVERSAL
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
Product "1" -- "0..*" OrderItem : selected in
Order "1" *-- "0..*" Payment : payment attempts
Promotion "0..1" -- "0..*" Order : applied to
User "1" -- "0..*" LoyaltyTransaction : earns / reverses
Order "0..1" -- "0..*" LoyaltyTransaction : origin

User ..> Role
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
LoyaltyTransaction ..> LoyaltyType

note bottom of Product
  Product.stock used only for legacy orders (marker false).
  Public stock = ingredient capacity for S without toppings.
  Client size/toppings are validated, prices recomputed on server.
end note
note bottom of Promotion
  Domain only: FR-17 is Won't.
  discountAmount = 0 in minimum.
end note
note bottom of LoyaltyTransaction
  Domain only: FR-18/19 are Won't.
  No runtime accrual in minimum.
end note
note bottom of Payment
  Only SUCCESS results are cached by API key.
  REFUNDED is an enum value, not an enabled FR-26 flow.
end note
class Ingredient {
  +id: String
  +name: String
  +unit: IngredientUnit
  +tracked: Boolean
  +onHand: Decimal(18,3)
  +reserved: Decimal(18,3)
}
class Recipe {
  +id: String
  +productId: String [0..1]
  +size: String [0..1]
  +topping: String [0..1]
}
class RecipeLine {
  +recipeId: String
  +ingredientId: String
  +quantity: Decimal(18,3)
}
class StockMovement {
  +id: String
  +ingredientId: String
  +actorId: String
  +kind: RECEIVE | ADJUST
  +quantity: Decimal(18,3) <<signed delta>>
  +onHandAfter: Decimal(18,3)
  +reason: String
  +createdAt: DateTime
}
class OrderIngredient {
  +orderId: String
  +ingredientId: String
  +quantity: Decimal(18,3) <<immutable>>
}
enum IngredientUnit {
  g
  ml
  piece
}
Product "0..1" -- "0..*" Recipe : product + size selector
Recipe "1" *-- "1..*" RecipeLine : contains
Ingredient "1" -- "0..*" RecipeLine : requires
Ingredient "1" -- "0..*" StockMovement : balance audit
User "1" -- "0..*" StockMovement : records
Order "1" *-- "0..*" OrderIngredient : aggregate snapshot
Ingredient "1" -- "0..*" OrderIngredient : reserved / consumed
Ingredient ..> IngredientUnit
note bottom of Ingredient
  available = onHand - reserved; 0 <= reserved <= onHand.
  Water / ice unlimited; only tracked lines limit cups.
  HTTP amounts are decimal strings; canonical units.
end note
note right of Recipe
  Exactly one selector: productId+size OR topping.
  Unique product+size and unique topping.
  Unique recipeId+ingredientId; positive quantities.
  Empty/missing base or no tracked base line is unavailable.
end note
note bottom of OrderIngredient
  Unique orderId+ingredientId; quantities aggregate ALL cart lines.
  New orders marker true: reserve snapshot; payment consumes;
  decline keeps; owner cancel releases reserved exactly once.
  Recipe edits never modify snapshot; legacy false has no snapshot.
end note
@enduml
