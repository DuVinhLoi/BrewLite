@startuml
' BrewLite Assignment 2 - UC-04; authoritative SRS 3.5-3.6 and uc-checkout.md
' A2 §4.1: four swimlanes; three mandatory failures all have explicit ends.
!pragma useVerticalIf on
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam ArrowColor #55738A
skinparam ActivityBorderColor #46677B
skinparam ActivityBackgroundColor #EAF3FA
skinparam ActivityDiamondBackgroundColor #FFF2D8
skinparam ActivityDiamondBorderColor #B58B45
skinparam ActivityBarColor #46677B
title BrewLite A2 - Activity: UC-04 Checkout

|Customer|
start
:Open cart and press "Checkout";
|Next.js UI|
if (Customer authenticated?) then (no - E1a)
  :Keep cart; open /login?next=/checkout;
  |Customer|
  if (Complete login?) then (yes)
    :Log in as CUSTOMER;
    |Next.js UI|
    :Return to /checkout with same cart;
  else (no)
    |Next.js UI|
    :Remain at login; cart retained;
    stop
  endif
else (yes)
endif
:Show cart summary and wallet/card choices;
|Customer|
:Choose WALLET or CARD; confirm payment;
|Next.js UI|
:Disable confirm button;
:Create Idempotency-Key for payment session;
:POST /orders (JWT, items; NO client prices);
|NestJS API|
:JWT guard: role = CUSTOMER;
if (401 from POST /orders?) then (E1a)
  :Return 401 UNAUTHORIZED; no order;
  |Next.js UI|
  :Keep cart; redirect to login;
  |Customer|
  :Sign in and return to checkout;
  |Next.js UI|
  :Retry POST /orders only after login;
  |NestJS API|
  :Validate new JWT / CUSTOMER role;
else (authenticated)
endif
:Validate DTO; recompute server-side price (BR-01/02);
if (Bad DTO or unknown product?) then (yes - E6)
  :Return 400 VALIDATION_ERROR / 404 PRODUCT_NOT_FOUND;
  |Next.js UI|
  :Show validation errors; preserve cart;
  |Customer|
  :Correct cart later;
  stop
else (valid)
endif
:Start DB transaction; check stock atomically;
if (Any product OUT_OF_STOCK?) then (yes - E2)
  :ROLLBACK; return 409 OUT_OF_STOCK;
  :No Order or stock change;
  |Next.js UI|
  :Mark unavailable items; return to cart;
  |Customer|
  :Edit cart; can try checkout again;
  stop
else (no)
  :Reserve stock; create Order PENDING + OrderItems;
  :COMMIT transaction; return 201 orderId + total;
endif
|Next.js UI|
:Retain orderId, owner and same Idempotency-Key;
:POST /payments (JWT, orderId, method, key);
|NestJS API|
:JWT guard / CUSTOMER role;
if (401 from POST /payments?) then (yes - E1b)
  :Return 401; do not change order;
  |Next.js UI|
  :Keep cart, orderId, owner and key; open login;
  |Customer|
  :Log in again;
  |Next.js UI|
  :GET /orders/:id with new JWT;
  |NestJS API|
  :Verify SAME account owns order;
  if (Different account / 403?) then (yes)
    :Reject access; do not create another order;
    |Next.js UI|
    :Request correct account or show own history;
    stop
  else (owner verified)
  endif
  if (Status PAID/PREPARING/READY/COMPLETED?) then (yes)
    :Return current order details;
    |Next.js UI|
    :Show already-paid order; no new charge;
    stop
  else (no)
  endif
  if (Status CANCELLED?) then (yes)
    :Return CANCELLED;
    |Next.js UI|
    :Show cancelled order; stop payment;
    stop
  else (PENDING / PAYMENT_FAILED)
    :Return payable order;
    |Next.js UI|
    :POST /payments again with SAME orderId/key;
    |NestJS API|
    :Recheck JWT / DTO / ownership;
  endif
else (authenticated)
endif
:Validate payment DTO/key and ownership;
if (Invalid request / unauthorized order?) then (yes - E6/E7)
  :Return 400/403/404; do not call Payment Service;
  |Next.js UI|
  :Explain error; keep cart and order;
  stop
else (valid)
endif
:Look up SUCCESS by owner + order + key + paymentMethod (BR-05);
if (API SUCCESS replay? E4a) then (yes)
  :Return 200 original SUCCESS/paymentId;
  |Next.js UI|
  :Show PAID receipt; clear cart;
  |Customer|
  :See order confirmation;
  stop
else (new attempt)
endif
if (Order PENDING or PAYMENT_FAILED?) then (no - E7)
  :Return 409 ORDER_NOT_PAYABLE;
  |Next.js UI|
  :Show order status; keep cart;
  stop
else (yes)
endif
if (Order status PAYMENT_FAILED?) then (yes - A3)
  :Transition PAYMENT_FAILED -> PENDING;
else (PENDING)
endif
|Payment Service|
:charge(orderId, Order.total, method);
if (Charge successful?) then (no - E3)
  :Return DECLINED;
  |NestJS API|
  :Save Payment FAILED;
  :Transition PENDING -> PAYMENT_FAILED;
  :Return 402 PAYMENT_DECLINED;
  |Next.js UI|
  :Keep cart, orderId and reserved stock;
  :Show payment failure + Retry same Order;
  |Customer|
  :May retry with new method; no new Order;
  stop
else (yes)
  :Return SUCCESS;
  |NestJS API|
  :DB transaction: save one Payment SUCCESS;
  :Transition PENDING -> PAID; COMMIT;
  note right
    E8b: If API stops before COMMIT, Order stays
    PENDING; retry is a new attempt (accepted risk,
    simulated money, SRS 3.4).
  end note
  :Return 201 SUCCESS, orderStatus PAID;
  |Next.js UI|
  :Show receipt; clear cart only on SUCCESS;
  |Customer|
  :See order code and track order;
  stop
endif
@enduml
