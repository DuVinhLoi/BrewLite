# Local Compose only: apps read their own .env files for non-Docker local runs.
# Use a long random hexadecimal password (URL-safe), never demo credentials in production.
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000
API_PORT=4000
# Production Compose only; use lowercase GHCR repository, immutable full commit SHA.
REGISTRY_IMAGE=
RELEASE_SHA=
# VNPay sandbox (optional). Without these the API still starts, but creating a payment URL returns 502.
# Keep the real values only in your own .env, never in git. WEB_URL must match the web port above.
VNP_TMN_CODE=
VNP_HASH_SECRET=
WEB_URL=http://localhost:3000
# Optional, sandbox defaults are built in.
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
