# Mẫu biến môi trường. Có 2 cách chạy, DATABASE_URL khác nhau:
#
# 1) docker compose up --build  (README "Chạy nhanh")
#    `cp .env.example .env` là tùy chọn (compose đã có mặc định dev). Compose đọc .env để thay JWT_SECRET, PORT,
#    CORS_ORIGIN, NEXT_PUBLIC_*. Compose KHÔNG dùng DATABASE_URL bên dưới: backend trong container luôn nối `db:5432`.
#
# 2) Chạy rời (cd backend && npm run start:dev)
#    Backend không tự đọc file .env: đặt biến trong shell (ví dụ export DATABASE_URL=...) rồi chạy.
#    Không đặt DATABASE_URL thì backend dùng kho in-memory (không cần DB). Host `localhost` vì DB chạy qua
#    `docker compose up -d db` và mở cổng 5432 ra máy.
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite
JWT_SECRET=change-me-in-production
PORT=3000
CORS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_PAYMENT_MODE=api
# Nút "Quầy (demo)" ở /history (mô phỏng Barista, ngoài MVP theo đề §3.2). Mặc định bật; đặt false để ẩn khi không demo.
NEXT_PUBLIC_DEMO_COUNTER=true
